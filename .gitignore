# ============================================
# ENVIRONMENT VARIABLES & SECRETS (CRITICAL)
# ============================================
# Never commit these — they contain payment keys,
# 1LINK/Fast API secrets, email passwords, JWT secrets, etc.
.env
.env.*
!.env.example
*.env
.env.local
.env.development
.env.production
.env.test
.env.*.local

# Config files that may contain secrets
config/secrets.json
config/*.secret.*
*.pem
*.key
*.p12
*.pfx
secrets/
.vercel/.env*

