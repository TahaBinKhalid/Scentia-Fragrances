# .env.example  (SAFE — no real values)
PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret

# 1LINK / Payment Gateway
ONELINK_CLIENT_ID=your_client_id
ONELINK_CLIENT_SECRET=your_client_secret
